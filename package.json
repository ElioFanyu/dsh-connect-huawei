{
  "name": "dsh-connect-huawei",
  "displayName": "DSH Connect Huawei",
  "description": "把华为「码道 CodeArts」与「果办 OfficeAce」接入 DeepSeek Harness：两条 provider 路由、账号池与自动换号、按账号读取积分余量、逐模型勾选与图片输入能力、码道并发会话闸门，以及输入框里的胶囊积分读数。页面沿用 dsh-connect-workbuddy 的卡片样式。",
  "version": "1.3.0",
  "author": "ElioFanyu",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "huawei",
    "codearts",
    "officeace",
    "model-provider",
    "credits"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.mjs",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0 || >=1.0.0-0 <2.0.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
